# MongoDB connection string. MongoDB must run as a replica set (Atlas does).
# Local single-node replica set example:
#   DATABASE_URL="mongodb://127.0.0.1:27017/royal_paan?replicaSet=rs0&directConnection=true"
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/royal_paan?retryWrites=true&w=majority"

# Set to "false" only when serving the production build over plain HTTP on the
# shop's LAN (e.g. http://192.168.1.20:3000). Leave unset behind HTTPS.
COOKIE_SECURE=

# Public address used for the table QR code (e.g. https://royalpaan.example.com).
# If empty, the current host is used, with localhost swapped for this machine's LAN IP.
PUBLIC_BASE_URL=

# Shared secret for the shop laptop print agent (print-agent/start-agent.bat).
PRINT_AGENT_KEY=
