generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  FLAT
  PERCENT
}

enum OrderStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum TableOrderStatus {
  RUNNING
  BILLED
  PAID
  CANCELLED
}

enum Role {
  ADMIN
  STAFF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILLED
}

enum OrderItemStatus {
  PENDING
  SENT_TO_KITCHEN
  CANCELLED
}

enum TableArea {
  INDOOR
  OUTDOOR
  AC_HALL
  OTHER
}

/// One size of a menu item, e.g. { name: "Large", price: 6000 }.
type Variant {
  name  String
  price Int
}

/// All money is stored in paise (1 rupee = 100 paise).
model MenuItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  /// Optional Hindi name shown to staff who use the app in Hindi.
  nameHi      String?
  /// The single price, or the lowest size price when the item has sizes.
  price       Int
  /// Empty = one fixed price.
  variants    Variant[]
  category    String
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@map("menu_items")
}

model Order {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber    Int           @unique
  customerName   String?
  customerPhone  String?
  /// Last 10 digits of customerPhone, used for returning-customer lookup.
  phoneKey       String?
  tableNumber    String?
  subtotal       Int
  discountType   DiscountType?
  /// The raw discount input (rupees for FLAT, percent for PERCENT).
  discountValue  Float?
  discountAmount Int           @default(0)
  total          Int
  amountPaid     Int           @default(0)
  balanceDue     Int
  status         OrderStatus
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([balanceDue])
  @@index([customerPhone])
  @@index([phoneKey])
  @@map("orders")
}

/// A bill line. Name, size, category and price are snapshots taken when the
/// line was added, so editing or deleting the menu item never changes old bills.
model OrderItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String  @db.ObjectId
  order       Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Set to null when the menu item is deleted.
  menuItemId  String? @db.ObjectId
  itemName    String
  itemNameHi  String?
  variantName String?
  category    String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model Payment {
  id      String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId String        @db.ObjectId
  order   Order         @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount  Int
  method  PaymentMethod
  paidAt  DateTime      @default(now())

  @@index([orderId])
  @@index([paidAt])
  @@index([method, paidAt])
  @@map("payments")
}

/// { _id: "order", seq } – incremented inside the order-creation transaction.
model Counter {
  id  String @id @map("_id")
  seq Int

  @@map("counters")
}

model Customer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  phoneKey    String   @unique
  phone       String
  name        String?
  /// Lowercased words of the name, for "any word" prefix search.
  nameWords   String[]
  lastVisitAt DateTime
  createdAt   DateTime @default(now())

  @@index([nameWords])
  @@index([lastVisitAt])
  @@map("customers")
}

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  username          String    @unique
  name              String
  passwordHash      String
  role              Role      @default(STAFF)
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions    Session[]
  tableOrders TableOrder[]

  @@map("users")
}

model Session {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash  String   @unique
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// { _id: "user:<username>" }
model LoginThrottle {
  id          String    @id @map("_id")
  failures    Int
  windowStart DateTime
  lockedUntil DateTime?

  @@map("login_throttles")
}

model Table {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  tableNumber String      @unique
  name        String?
  capacity    Int
  area        TableArea   @default(OTHER)
  isActive    Boolean     @default(true)
  /// The RUNNING TableOrder on this table, if any. Set/cleared inside transactions
  /// that write the table first, so two staff can never open two orders at once.
  activeOrderId String?   @db.ObjectId
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tableOrders TableOrder[]

  @@index([area])
  @@index([isActive])
  @@map("tables")
}

model TableOrder {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  tableId       String        @db.ObjectId
  table         Table         @relation(fields: [tableId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staffId       String        @db.ObjectId
  staff         User          @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pax           Int?
  status        TableOrderStatus @default(RUNNING)
  subtotal      Int           @default(0)
  discountType  DiscountType?
  discountValue Float?
  discountAmount Int          @default(0)
  cgst          Float?
  sgst          Float?
  serviceCharge Int?
  roundOff      Int?
  total         Int           @default(0)
  amountPaid    Int           @default(0)
  balanceDue    Int           @default(0)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  closedAt      DateTime?

  items TableOrderItem[]
  kots  KOT[]
  bills Bill[]

  @@index([tableId])
  @@index([staffId])
  @@index([status])
  @@index([createdAt])
  @@map("table_orders")
}

model TableOrderItem {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  tableOrderId  String            @db.ObjectId
  tableOrder    TableOrder        @relation(fields: [tableOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menuItemId    String?           @db.ObjectId
  itemName      String
  itemNameHi    String?
  variantName   String?
  category      String
  unitPrice     Int
  quantity      Int
  lineTotal     Int
  note          String?
  status        OrderItemStatus   @default(PENDING)
  kotId         String?           @db.ObjectId
  kot           KOT?              @relation(fields: [kotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tableOrderId])
  @@index([menuItemId])
  @@index([status])
  @@index([kotId])
  @@map("table_order_items")
}

model KOT {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  kotNumber   Int       @unique
  tableOrderId String   @db.ObjectId
  tableOrder  TableOrder @relation(fields: [tableOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  printedBy   String    @db.ObjectId
  staffName   String
  tableNumber String
  printedAt   DateTime  @default(now())
  isDuplicate Boolean   @default(false)
  /// true while the KOT waits at the counter to be printed (older KOTs lack the field).
  awaitingPrint Boolean?
  createdAt   DateTime  @default(now())

  items TableOrderItem[]

  @@index([tableOrderId])
  @@index([printedAt])
  @@index([awaitingPrint])
  @@map("kots")
}

model Bill {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  billNumber   Int        @unique
  tableOrderId String     @db.ObjectId
  tableOrder   TableOrder @relation(fields: [tableOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subtotal     Int
  discount     Int        @default(0)
  cgst         Float?
  sgst         Float?
  serviceCharge Int?
  roundOff     Int?
  total        Int
  isDuplicate  Boolean    @default(false)
  printedAt    DateTime   @default(now())
  paidAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([tableOrderId])
  @@index([printedAt])
  @@map("bills")
}

enum ExpenseCategory {
  RATION
  GAS
  STAFF_ADVANCE
  OTHER
}

/// Kirana / shop expenses entered by an admin: ration, gas, staff salary advances…
model Expense {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  category      ExpenseCategory
  /// Paise.
  amount        Int
  note          String?
  method        PaymentMethod   @default(CASH)
  /// Local midnight (Asia/Kolkata) of the day the money was spent.
  spentOn       DateTime
  /// For STAFF_ADVANCE: who got the advance. The name is a snapshot.
  staffId       String?         @db.ObjectId
  staffName     String?
  createdById   String          @db.ObjectId
  createdByName String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([spentOn])
  @@index([category, spentOn])
  @@index([staffId, spentOn])
  @@map("expenses")
}
